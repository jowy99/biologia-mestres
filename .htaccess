# Cabeceras de seguridad (servidores Apache)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# Pàgina pròpia per a les adreces que no existeixen
ErrorDocument 404 /404.html
# No servir los archivos de trabajo
RedirectMatch 404 ^/?(_tareas|build\.mjs|README\.md)(/.*)?$
RedirectMatch 404 /manual\.md$
